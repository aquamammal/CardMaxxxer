<?xml version="1.0" encoding="utf-8"?>
<!--
  Data extraction rules for CardMaxxxer.
  This app stores sensitive financial data locally with SQLCipher encryption.
  All data extraction is excluded to protect user privacy.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all cloud backup content -->
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all device transfer content -->
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>